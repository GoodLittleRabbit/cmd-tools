{
  "name": "cmd-tools",
  "version": "0.1.0",
  "description": "cmd-tools — Ink TUI to build, pack, and deploy over SSH",
  "type": "module",
  "private": true,
  "bin": {
    "cmd-tools": "./bin/cmd-tools.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/run.mjs",
    "dev": "pnpm build && pnpm start",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
